# CentralD release environment. Copy this file to `.env` and fill in the
# values. `.env` is gitignored; never commit real secrets.
#
# The release and build scripts load `.env` automatically via
# `node --env-file-if-exists=.env`, so secrets below are available without
# exporting them in every shell. Public verification keys are NOT stored here:
# they belong in the tracked `centrald.config`.

# GitHub personal access token (repo scope): used for release creation and
# asset uploads. `gh auth login` is an alternative; GH_TOKEN also works when
# running `npm run release` on a user's Windows host.
GH_TOKEN=

# Release publishing gates. Both must be exactly YES before `npm run release`
# creates the version tag, pushes it, uploads assets, and publishes.
CENTRALD_RELEASE_PUBLISH=YES
CENTRALD_GITHUB_IMMUTABLE_RELEASES=YES

# Tauri updater signing key: the CONTENT of the private key file generated by
# `npx tauri signer generate`, not a path. Used by tauri build for NSIS and by
# the host-side signing of the Docker-built Linux AppImage.
TAURI_SIGNING_PRIVATE_KEY=
# Set only when the updater key is encrypted.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Minisign signing key: absolute path to the secret key file. Every release
# artifact and both manifests receive a `.minisig`.
MINISIGN_SECRET_KEY_FILE=
# CI only: base64 content of an ephemeral unprotected Minisign key, materialized
# to a mode-0600 file by the workflow. Requires:
CENTRALD_MINISIGN_UNPROTECTED_KEY=YES

# Optional overrides.
# CENTRALD_RELEASE_NOTES=CentralD 0.1.0-alpha.2
# CENTRALD_RELEASE_TIMESTAMP=2026-08-12T12:00:00+00:00

# Emergency only: allow moving a mutable channel backward in version precedence.
# CENTRALD_ALLOW_CHANNEL_ROLLBACK=YES
