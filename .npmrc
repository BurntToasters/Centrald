# CentralD npm policy. This file applies to every project-scoped npm command
# in this repository, including the Docker builder images (the repo is copied
# into the build context, so containers inherit the same policy).
#
# Supply-chain gate: never install a package version that has been published
# for less than three days. New releases are not accepted.
min-release-age=3

# Refuse to run with a Node or npm older than package.json "engines"; older
# npm silently ignores min-release-age.
engine-strict=true
