# CentralD build configuration. This file is intentionally tracked.
# Do not put credentials, private keys, signing secrets, or database URLs here.

# Source repository and default release origin baked into all binaries.
REPO_URL=https://github.com/BurntToasters/centrald

# Optional mutable update-manifest base. When blank, stable GitHub feeds use
# <REPO_URL>/releases/latest/download; non-stable GitHub feeds use the dedicated
# centrald-channels branch through raw.githubusercontent.com. Generic origins
# use <REPO_URL>/<channel>/latest.
UPDATE_BASE_URL=

# Optional immutable artifact location. Use {version} or {tag}; when blank,
# GitHub Releases use /releases/download/{tag} and generic origins use
# /releases/{version}.
ARTIFACT_BASE_URL_TEMPLATE=

# Optional CDN base hosting the mutable channel manifests (updated.centrald.dev
# style). When set, every channel resolves its update base to
# <CDN_BASE_URL>/<channel> (e.g. .../beta) and the release flow syncs the
# signed manifests to the configured S3 bucket after publishing.
CDN_BASE_URL=

# Release metadata shared by the server, clients, Admin app, and release tools.
RELEASE_CHANNEL=prerelease
RELEASE_MANIFEST=centrald-release.yml
TAURI_UPDATE_MANIFEST=centrald-admin-updater.json

# Public Tauri updater verification key. Public material only; the private
# signing key must be supplied through TAURI_SIGNING_PRIVATE_KEY at release time.
TAURI_UPDATER_PUBKEY=

# Public Minisign verification key for every release artifact. Public material
# only; release signing uses MINISIGN_SECRET_KEY_FILE and is never baked in.
MINISIGN_PUBLIC_KEY=
