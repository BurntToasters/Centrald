{
  "name": "centrald",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:win": "node scripts/setup.js --windows",
    "setup:docker:win": "node scripts/setup-docker-win.js",
    "dev:server": "cargo run --locked -p centrald-server -- run",
    "dev:client": "cargo run --locked -p centrald-client -- rescue",
    "dev:admin": "tauri dev --config apps/admin/src-tauri/tauri.conf.json",
    "dev:admin:web": "vite --config apps/admin/vite.config.ts",
    "build": "npm run build:rust && npm run build:admin",
    "build:rust": "cargo build --workspace --locked",
    "build:admin": "tauri build --config apps/admin/src-tauri/tauri.conf.json",
    "build:admin:web": "vite build --config apps/admin/vite.config.ts",
    "build:win:x64": "node scripts/build.js --target windows-x64",
    "build:win:arm64": "node scripts/build.js --target windows-arm64",
    "build:linux:x64": "node scripts/build.js --target linux-x64",
    "build:all": "node scripts/build.js --target all",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint apps/admin/src scripts && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc -p apps/admin/tsconfig.json --noEmit",
    "test": "vitest run --config apps/admin/vitest.config.ts && node --test scripts/tests/*.test.js",
    "test:rust": "cargo test --workspace --locked",
    "qa": "node scripts/qa.js",
    "release:prepare": "node scripts/release.js prepare",
    "release:build": "node scripts/release.js build",
    "release:verify": "node scripts/release.js verify",
    "release:publish": "node scripts/release.js publish",
    "release:publish-channel": "node scripts/release.js publish-channel",
    "release": "node scripts/release.js all",
    "config:check": "node scripts/check-config.js",
    "build:linux:x64:native": "node scripts/build.js --target linux-x64 --native",
    "package:linux": "node scripts/package-linux.js",
    "release:assemble": "node scripts/release.js assemble",
    "release:manifests": "node scripts/release.js manifests",
    "release:sign": "node scripts/release.js sign",
    "check:onboarding": "node scripts/check-onboarding.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
