{
  "name": "centrald",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^24.22.1 || >=26.13.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "cargo run --locked -p centrald-server -- run",
    "build": "npm run build:web && cargo build --workspace --release --locked",
    "build:web": "vite build --config web/vite.config.ts",
    "build:rust": "cargo build --workspace --locked",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "eslint web tests scripts && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "node --test scripts/cargo-safe-update.test.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e": "npm run build:web && CENTRALD_UPDATE_PUBKEY=$(node tests/e2e/minisign.ts) CENTRALD_REQUIRE_UI=1 cargo build --workspace --locked && playwright test --config tests/e2e/playwright.config.ts",
    "test:rust": "cargo test --workspace --locked",
    "check:cargo-update-policy": "node scripts/check-cargo-update-policy.mjs",
    "deps:rust:update": "node scripts/cargo-safe-update.mjs --manifest-path Cargo.toml",
    "package": "node scripts/package.mjs",
    "site:install": "npm --prefix site ci",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:check": "npm --prefix site run check",
    "site:sync": "npm --prefix site run sync-docs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
