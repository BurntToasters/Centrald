post_install() {
  echo "Connect this machine to your CentralD server:"
  echo "  sudo centrald-agent enroll"
}

post_upgrade() {
  # pacman's own daemon-reload hook runs after this function.
  systemctl daemon-reload 2>/dev/null || true
  systemctl try-restart centrald-agent.service 2>/dev/null || true
}

pre_remove() {
  systemctl disable --now centrald-agent.service 2>/dev/null || true
}
