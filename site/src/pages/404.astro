---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found - CentralD"
  description="The requested CentralD documentation page does not exist."
>
  <main class="not-found">
    <h1>404</h1>
    <p>The page you are looking for does not exist.</p>
    <a class="button primary" href="/">Back to the homepage</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .not-found h1 {
    font-size: 3.5rem;
    margin: 0;
    color: var(--accent);
  }
  .not-found p {
    color: var(--muted);
    margin: 0 0 1rem;
  }
</style>
