---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CentralD - Remote management for your home lab"
  description="CentralD shows the health of every Linux and Windows machine in your home lab and lets you run commands, open terminals, and install updates from one web app."
>
  <main class="home-main">
    <!-- Ambient Radial Glows -->
    <div class="ambient-glow glow-top" aria-hidden="true"></div>
    <div class="ambient-glow glow-bottom" aria-hidden="true"></div>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-badge-container">
        <span class="badge purple hero-badge">
          <svg
            class="badge-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Home lab remote management
        </span>
      </div>

      <h1 class="hero-title">
        Every machine in your lab. <span class="gradient-text"
          >One web app.</span
        >
      </h1>

      <p class="hero-lede">
        CentralD shows the health of every Linux and Windows machine you own,
        and lets you run commands, open a terminal, and install updates on them
        from your browser. Install the server once, then add each machine with
        one copied command.
      </p>

      <div class="hero-actions">
        <a class="button primary lg" href="/docs/quickstart">
          <span>Get started</span>
          <svg class="btn-arrow" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a class="button secondary lg" href="/docs/guide">
          <svg
            class="btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path
              d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
            ></path>
          </svg>
          <span>User guide</span>
        </a>
      </div>
    </section>

    <!-- Interactive Architecture Visualization -->
    <section class="preview-section">
      <div class="glass-card preview-card">
        <div class="preview-header">
          <div class="window-controls">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="preview-title">How CentralD fits together</span>
          <div class="preview-status">
            <span class="status-indicator"></span>
            <span>HTTPS only</span>
          </div>
        </div>

        <div class="architecture-diagram">
          <div class="arch-box node-admin">
            <div class="arch-box-header">
              <span class="badge purple">Your browser</span>
              <span class="arch-box-sub">Any desktop or phone</span>
            </div>
            <p class="arch-box-desc">
              Password plus optional two-factor sign-in. Nothing to install.
            </p>
            <div class="arch-pill">Web app</div>
          </div>

          <div class="arch-flow">
            <div class="flow-line"><span class="flow-dot"></span></div>
            <span class="flow-label">HTTPS</span>
          </div>

          <div class="arch-box node-server">
            <div class="arch-box-header">
              <span class="badge teal">centrald-server</span>
              <span class="arch-box-sub">Any Linux machine</span>
            </div>
            <div class="server-specs">
              <div class="spec-row">
                <span class="spec-label">Port:</span>
                <code>7443 (HTTPS)</code>
              </div>
              <div class="spec-row">
                <span class="spec-label">Runs as:</span>
                <code>centrald (no root)</code>
              </div>
              <div class="spec-row">
                <span class="spec-label">Data:</span>
                <code>SQLite, /var/lib/centrald</code>
              </div>
              <div class="spec-row">
                <span class="spec-label">Certificates:</span>
                <code>own CA, pinned by agents</code>
              </div>
            </div>
          </div>

          <div class="arch-flow">
            <div class="flow-line reverse"><span class="flow-dot"></span></div>
            <span class="flow-label">Outbound only</span>
          </div>

          <div class="arch-box node-client">
            <div class="arch-box-header">
              <span class="badge amber">centrald-agent</span>
              <span class="arch-box-sub">Linux & Windows</span>
            </div>
            <p class="arch-box-desc">
              Connects out to the server. Opens no ports on the machine.
            </p>
            <div class="arch-pill client-pill">0 inbound ports</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabbed Quick-Start Code Section -->
    <section class="quickstart-section">
      <div class="section-heading">
        <span class="badge teal">Quickstart</span>
        <h2>Up and running in five minutes</h2>
        <p>
          Install one package, open the web app, copy one command per machine.
        </p>
      </div>

      <div class="code-showcase glass-card">
        <div class="tab-bar" role="tablist">
          <button
            class="tab-btn active"
            data-tab="tab-server"
            role="tab"
            aria-selected="true"
          >
            <svg
              class="tab-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
            <span>1. Install the server</span>
          </button>
          <button
            class="tab-btn"
            data-tab="tab-client"
            role="tab"
            aria-selected="false"
          >
            <svg
              class="tab-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span>2. Open the web app</span>
          </button>
          <button
            class="tab-btn"
            data-tab="tab-admin"
            role="tab"
            aria-selected="false"
          >
            <svg
              class="tab-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
            <span>3. Add machines</span>
          </button>
        </div>

        <div class="tab-content-container">
          <div class="tab-content active" id="tab-server">
            <div class="code-header">
              <span class="code-title">Debian, Ubuntu, Fedora, or Arch</span>
              <button
                class="copy-snippet-btn"
                data-clipboard-target="#snippet-server"
                aria-label="Copy server commands"
              >
                <svg
                  class="copy-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path>
                </svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <pre
              class="code-block"><code id="snippet-server"><span class="code-comment"># Debian, Ubuntu, Raspberry Pi OS</span>
sudo apt install ./centrald-server_*.deb

<span class="code-comment"># Fedora</span>
sudo dnf install ./centrald-server-*.rpm

<span class="code-comment"># The server starts at once. Show its address and setup code again:</span>
sudo centrald-server status</code></pre>
          </div>

          <div class="tab-content" id="tab-client">
            <div class="code-header">
              <span class="code-title">First sign-in</span>
              <button
                class="copy-snippet-btn"
                data-clipboard-target="#snippet-client"
                aria-label="Copy first sign-in steps"
              >
                <svg
                  class="copy-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path>
                </svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <pre
              class="code-block"><code id="snippet-client"><span class="code-comment"># 1. Open the address the server printed, e.g.</span>
https://192.168.1.10:7443

<span class="code-comment"># 2. Enter the setup code from the server, e.g. K7PX-2MQD-9RTA</span>
<span class="code-comment"># 3. Pick a username and password, then turn on two-factor</span>
<span class="code-comment">#    sign-in under Settings</span></code></pre>
          </div>

          <div class="tab-content" id="tab-admin">
            <div class="code-header">
              <span class="code-title">Add device → copy → paste</span>
              <button
                class="copy-snippet-btn"
                data-clipboard-target="#snippet-admin"
                aria-label="Copy add device steps"
              >
                <svg
                  class="copy-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path
                    d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                  ></path>
                </svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <pre
              class="code-block"><code id="snippet-admin"><span class="code-comment"># 1. In the web app select Add device, then Create join code</span>
<span class="code-comment"># 2. Linux: paste the copied command into a terminal</span>
<span class="code-comment">#    Windows: paste it into Terminal (Admin)</span>
<span class="code-comment"># 3. The command checks the server's key, installs the agent,</span>
<span class="code-comment">#    and the machine shows up as joined seconds later</span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Pillars Grid -->
    <section class="pillars-section">
      <div class="section-heading">
        <span class="badge purple">What you get</span>
        <h2>Simple to run, careful by default</h2>
        <p>
          Built for a LAN or VPN, with the security of a tool that holds root on
          your machines.
        </p>
      </div>

      <div class="features-grid">
        <div class="card feature-card">
          <div class="card-icon-wrapper purple">
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3>Live health at a glance</h3>
          <p>
            CPU, memory, disks, uptime, and addresses for every machine, plus
            pending updates, reboot-required, and failed services on Linux.
            Offline machines stand out right away.
          </p>
          <div class="card-tags">
            <span class="badge">Live dashboard</span>
            <span class="badge">24-hour charts</span>
          </div>
        </div>

        <div class="card feature-card">
          <div class="card-icon-wrapper teal">
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <h3>Commands and a real terminal</h3>
          <p>
            Run a command on one machine or fifty and watch the output stream
            in. Open a full interactive shell in the browser. Install updates
            (apt, dnf, pacman) or reboot with one click.
          </p>
          <div class="card-tags">
            <span class="badge teal">Live output</span>
            <span class="badge teal">Browser terminal</span>
          </div>
        </div>

        <div class="card feature-card">
          <div class="card-icon-wrapper amber">
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3>No trust on first use</h3>
          <p>
            Agents and install commands pin the server's key before sending
            anything. Join codes are single-use and never appear on a command
            line. Machines enrolled as monitor-only refuse every command
            themselves.
          </p>
          <div class="card-tags">
            <span class="badge amber">Pinned TLS</span>
            <span class="badge amber">Monitor-only mode</span>
          </div>
        </div>

        <div class="card feature-card">
          <div class="card-icon-wrapper cyan">
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <h3>Accounts worth trusting</h3>
          <p>
            Argon2id passwords, two-factor sign-in, strict same-site sessions,
            sign-in throttling, and an activity log of who did what. The server
            itself runs without root.
          </p>
          <div class="card-tags">
            <span class="badge">Two-factor</span>
            <span class="badge">Activity log</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Documentation Grid -->
    <section class="docs-section">
      <div class="section-heading">
        <span class="badge slate">Documentation</span>
        <h2>Guides and reference</h2>
      </div>

      <div class="docs-grid">
        <a class="glass-card doc-card" href="/docs/guide">
          <div class="doc-card-header">
            <h3>User guide</h3>
            <span class="doc-arrow">→</span>
          </div>
          <p>
            Everyday tasks: devices, commands, the terminal, updates, more
            operators, and monitor-only machines.
          </p>
        </a>

        <a class="glass-card doc-card" href="/docs/operations">
          <div class="doc-card-header">
            <h3>Operations</h3>
            <span class="doc-arrow">→</span>
          </div>
          <p>
            Settings, firewalls, your own certificate, backups, upgrades,
            password resets, and troubleshooting.
          </p>
        </a>

        <a class="glass-card doc-card" href="/docs/threat-model">
          <div class="doc-card-header">
            <h3>Security model</h3>
            <span class="doc-arrow">→</span>
          </div>
          <p>
            What CentralD protects, against whom, and the limits you should know
            about.
          </p>
        </a>

        <a class="glass-card doc-card" href="/docs/architecture">
          <div class="doc-card-header">
            <h3>Architecture</h3>
            <span class="doc-arrow">→</span>
          </div>
          <p>
            How the server, agents, and web app talk: TLS pinning, enrollment,
            the agent protocol, and the data model.
          </p>
        </a>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="glass-card cta-card">
        <div class="cta-content">
          <h2>Ready to see your whole lab?</h2>
          <p>
            Free software under the GPL-3.0. Self-hosted, no telemetry, no cloud
            account.
          </p>
          <div class="cta-actions">
            <a class="button primary lg" href="/docs/quickstart"
              >Start with Quickstart</a
            >
            <a
              class="button secondary lg"
              href="https://github.com/BurntToasters/centrald"
              target="_blank"
              rel="noopener noreferrer">View on GitHub</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Tab Switching
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const panels = document.querySelectorAll<HTMLElement>(".tab-content");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
      });
      panels.forEach((p) => p.classList.remove("active"));

      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");

      const targetId = tab.getAttribute("data-tab");
      if (targetId) {
        document.getElementById(targetId)?.classList.add("active");
      }
    });
  });

  // Clipboard copy
  const copyBtns =
    document.querySelectorAll<HTMLButtonElement>(".copy-snippet-btn");
  copyBtns.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const targetSelector = btn.getAttribute("data-clipboard-target");
      if (!targetSelector) return;
      const target = document.querySelector(targetSelector);
      if (!target) return;

      const text = target.textContent || "";
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector(".copy-label");
        if (label) {
          const original = label.textContent;
          label.textContent = "Copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            label.textContent = original;
            btn.classList.remove("copied");
          }, 2000);
        }
      } catch (err) {
        console.error("Failed to copy", err);
      }
    });
  });
</script>

<style>
  .home-main {
    position: relative;
    overflow: hidden;
  }

  /* Ambient Glows */
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-top {
    top: 5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 48rem;
    height: 24rem;
    background: radial-gradient(
      circle,
      var(--ambient-glow-1) 0%,
      rgba(109, 74, 255, 0) 70%
    );
  }

  .glow-bottom {
    top: 55rem;
    right: 5%;
    width: 40rem;
    height: 20rem;
    background: radial-gradient(
      circle,
      var(--ambient-glow-2) 0%,
      rgba(79, 70, 229, 0) 70%
    );
  }

  /* Hero Section */
  .hero {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 5.5rem 1.5rem 3.5rem;
    text-align: center;
  }

  .hero-badge-container {
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    padding: 0.35rem 0.95rem;
    font-size: 0.8125rem;
  }

  .badge-icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    max-width: 17em;
    margin: 0 auto 1.5rem;
  }

  .gradient-text {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lede {
    max-width: 44em;
    margin: 0 auto 2.5rem;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-arrow {
    width: 1.1rem;
    height: 1.1rem;
  }

  .btn-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Preview Architecture Card */
  .preview-section {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .preview-card {
    padding: 1.5rem;
    overflow: hidden;
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .window-controls {
    display: flex;
    gap: 0.4rem;
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
  }

  .dot.red {
    background-color: #ef4444;
  }
  .dot.yellow {
    background-color: #f59e0b;
  }
  .dot.green {
    background-color: #10b981;
  }

  .preview-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--accent-teal);
    font-weight: 600;
  }

  .status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--accent-teal);
    box-shadow: 0 0 8px var(--accent-teal);
  }

  .architecture-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
  }

  .arch-box {
    flex: 1;
    background: var(--surface-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .arch-box-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .arch-box-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .arch-box-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
